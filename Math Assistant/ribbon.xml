  <Application.Views>
    <Ribbon>
      <Ribbon.ApplicationMenu>
        <ApplicationMenu CommandName="cmdFileMenu">
          <MenuGroup Class="MajorItems">
            <Button CommandName="cmdAbout" />
			<Button CommandName="cmdExit" />
          </MenuGroup>
        </ApplicationMenu>
      </Ribbon.ApplicationMenu>
      <Ribbon.Tabs>
        <Tab CommandName="cmdTabStart">
          <Tab.ScalingPolicy>
            <ScalingPolicy>
              <ScalingPolicy.IdealSizes>
				  <Scale Group="cmdGroupObject" Size="Medium" />
				  <Scale Group="cmdGroupCalculus" Size="Medium" />
				  <Scale Group="cmdGroupTriangle" Size="Medium" />
				  <Scale Group="cmdGroupConstant" Size="Medium" />
				  <Scale Group="cmdGroupSymbol" Size="Medium" />
              </ScalingPolicy.IdealSizes>
            </ScalingPolicy>
          </Tab.ScalingPolicy>
			<Group CommandName="cmdGroupObject"
					SizeDefinition="FourButtons">
				<Button CommandName="cmdButtonDivision" />
				<Button CommandName="cmdButtonPower" />
				<Button CommandName="cmdButtonRoot" />
				<Button CommandName="cmdButtonSubscript" />
			</Group>
			<Group CommandName="cmdGroupCalculus"
					SizeDefinition="ThreeButtons">
				<Button CommandName="cmdButtonIntegral" />
				<Button CommandName="cmdButtonDerivative" />
				<Button CommandName="cmdButtonLimits" />
			</Group>
			<Group CommandName="cmdGroupTriangle"
					SizeDefinition="NineButtons">
				<Button CommandName="cmdButtonSin" />
				<Button CommandName="cmdButtonCos" />
				<Button CommandName="cmdButtonTan" />
				<Button CommandName="cmdButtonLog" />
				<Button CommandName="cmdButtonExp" />
				<Button CommandName="cmdButtonAsin" />
				<Button CommandName="cmdButtonAcos" />
				<Button CommandName="cmdButtonAtan" />
				<Button CommandName="cmdButtonLn" />
			</Group>
			<Group CommandName="cmdGroupConstant"
                 SizeDefinition="TwoButtons">
				<Button CommandName="cmdButtonPi" />
				<Button CommandName="cmdButtonEuler" />
			</Group>
			<Group CommandName="cmdGroupSymbol"
                 SizeDefinition="TwoButtons">
				<Button CommandName="cmdButtonTheta" />
				<Button CommandName="cmdButtonPhi" />
			</Group>
		</Tab>
      </Ribbon.Tabs>
      <Ribbon.QuickAccessToolbar>
        <QuickAccessToolbar CommandName="cmdQat" />
      </Ribbon.QuickAccessToolbar>
    </Ribbon>
  </Application.Views>
</Application>